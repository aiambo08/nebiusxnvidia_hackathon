# Copy to .env and fill in locally. NEVER commit .env.
# Nebius Token Factory (OpenAI-compatible). Verify the region of the model you pick:
# some Nemotron models are served from eu-north1, others from us-central1.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs MUST be confirmed with `python scripts/list_models.py` (GET /v1/models).
# Do not trust these defaults until Gate F0 is passed.
RA_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
RA_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b

# Budget caps in USD (logical caps enforced client-side; see docs/budget.md)
RA_BUDGET_TOTAL_USD=30
RA_BUDGET_SOFT_CAP_USD=23
RA_BUDGET_DEMO_CAP_USD=25
RA_BUDGET_HARD_CAP_USD=27

# Camera source: integer index for webcam (0), file path, or rtsp:// URL
RA_CAMERA_URI=0
RA_DB_PATH=runs/agent.sqlite
